<?xml version="1.0"?>
<robot name="myarm2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Approximate MyArm-2 model for Gazebo integration.
       Link lengths are based on the MyArm-2 firmware values:
       L0=111 mm, L1=105 mm, L2=86 mm, L3=175 mm.
       This is a simplified collision/visual model, not the exact CAD mesh. -->
  <xacro:macro name="myarm2">
    <link name="arm_base_link">
        <inertial>
            <mass value="0.35"/>
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
            <material name="arm_dark">
                <color rgba="0.15 0.15 0.15 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.02"/>
            <geometry>
                <cylinder radius="0.04" length="0.04"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_base_fixed" type="fixed">
        <parent link="TORSO"/>
        <child link="arm_base_link"/>
        <origin xyz="0.14 0 0.11" rpy="0 0 0"/>
    </joint>

    <link name="arm_yaw_link">
        <inertial>
            <mass value="0.30"/>
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.03"/>
            <geometry>
                <box size="0.06 0.06 0.06"/>
            </geometry>
            <material name="arm_orange">
                <color rgba="0.95 0.45 0.10 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.03"/>
            <geometry>
                <box size="0.06 0.06 0.06"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_yaw_joint" type="revolute">
        <parent link="arm_base_link"/>
        <child link="arm_yaw_link"/>
        <origin xyz="0 0 0.04"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="10" velocity="2.0"/>
    </joint>

    <link name="arm_shoulder_link">
        <inertial>
            <mass value="0.35"/>
            <origin xyz="0 0 0.0525"/>
            <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.0525"/>
            <geometry>
                <box size="0.035 0.035 0.105"/>
            </geometry>
            <material name="arm_orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.0525"/>
            <geometry>
                <box size="0.035 0.035 0.105"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_shoulder_joint" type="revolute">
        <parent link="arm_yaw_link"/>
        <child link="arm_shoulder_link"/>
        <origin xyz="0 0 0.04"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
    </joint>

    <link name="arm_elbow_link">
        <inertial>
            <mass value="0.25"/>
            <origin xyz="0 0 0.043"/>
            <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.043"/>
            <geometry>
                <box size="0.030 0.030 0.086"/>
            </geometry>
            <material name="arm_orange"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.043"/>
            <geometry>
                <box size="0.030 0.030 0.086"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_elbow_joint" type="revolute">
        <parent link="arm_shoulder_link"/>
        <child link="arm_elbow_link"/>
        <origin xyz="0 0 0.105"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="15" velocity="2.0"/>
    </joint>

    <link name="arm_wrist_link">
        <inertial>
            <mass value="0.15"/>
            <origin xyz="0 0 0.025"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.030 0.030 0.050"/>
            </geometry>
            <material name="arm_dark"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.030 0.030 0.050"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_wrist_joint" type="revolute">
        <parent link="arm_elbow_link"/>
        <child link="arm_wrist_link"/>
        <origin xyz="0 0 0.086"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="2.0"/>
    </joint>

    <link name="arm_roll_link">
        <inertial>
            <mass value="0.10"/>
            <origin xyz="0 0 0.015"/>
            <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.015"/>
            <geometry>
                <cylinder radius="0.018" length="0.030"/>
            </geometry>
            <material name="arm_dark"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.015"/>
            <geometry>
                <cylinder radius="0.018" length="0.030"/>
            </geometry>
        </collision>
    </link>

    <joint name="arm_roll_joint" type="revolute">
        <parent link="arm_wrist_link"/>
        <child link="arm_roll_link"/>
        <origin xyz="0 0 0.05"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="5" velocity="3.0"/>
    </joint>

    <link name="gripper_base_link">
        <inertial>
            <mass value="0.08"/>
            <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.015"/>
            <geometry>
                <box size="0.04 0.06 0.03"/>
            </geometry>
            <material name="arm_dark"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.015"/>
            <geometry>
                <box size="0.04 0.06 0.03"/>
            </geometry>
        </collision>
    </link>

    <joint name="gripper_base_fixed" type="fixed">
        <parent link="arm_roll_link"/>
        <child link="gripper_base_link"/>
        <origin xyz="0 0 0.03"/>
    </joint>

    <link name="gripper_left_finger">
        <inertial>
            <mass value="0.03"/>
            <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.012 0.012 0.05"/>
            </geometry>
            <material name="gripper_metal">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.012 0.012 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="gripper_left_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_left_finger"/>
        <origin xyz="0 -0.018 0.03"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.03" effort="2" velocity="0.05"/>
    </joint>

    <link name="gripper_right_finger">
        <inertial>
            <mass value="0.03"/>
            <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.012 0.012 0.05"/>
            </geometry>
            <material name="gripper_metal"/>
        </visual>
        <collision>
            <origin xyz="0 0 0.025"/>
            <geometry>
                <box size="0.012 0.012 0.05"/>
            </geometry>
        </collision>
    </link>

    <joint name="gripper_right_joint" type="prismatic">
        <parent link="gripper_base_link"/>
        <child link="gripper_right_finger"/>
        <origin xyz="0 0.018 0.03"/>
        <axis xyz="0 -1 0"/>
        <limit lower="0.0" upper="0.03" effort="2" velocity="0.05"/>
    </joint>
  </xacro:macro>
</robot>

