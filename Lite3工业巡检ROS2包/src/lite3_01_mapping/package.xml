<?xml version="1.0"?>
<package format="3">
  <name>lite3_01_mapping</name>
  <version>0.1.0</version>
  <description>Dog 1 – LiDAR SLAM mapping + depth-camera patrol dog. Builds the shared map, runs waypoint patrol, detects anomalies, reports targets to fleet_manager.</description>
  <maintainer email="user@example.com">Dog 1 Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>lite3_inspection</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
